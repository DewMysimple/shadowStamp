  "styles": [
    ".StampDetail-module__6eujwG__root { z-index: var(--z-modal,100); position: fixed; inset: 0px; }",
    ".StampDetail-module__6eujwG__room { background: var(--color-cream-700); opacity: 0; transition: opacity var(--duration-base,.4s) var(--ease-standard); cursor: zoom-out; position: absolute; inset: 0px; }",
    ".StampDetail-module__6eujwG__room[data-open] { opacity: 1; }",
    ".StampDetail-module__6eujwG__room.StampDetail-module__6eujwG__isDragging { transition: none; }",
    ".StampDetail-module__6eujwG__roomLayer { pointer-events: none; position: absolute; inset: 0px; }",
    ".StampDetail-module__6eujwG__wrap { pointer-events: none; justify-content: center; align-items: center; display: flex; position: absolute; inset: 0px; }",
    ".StampDetail-module__6eujwG__card { --card-w-cap: calc(100vw - 2 * var(--space-lg)); --card-h: min(64svh, 540px, var(--card-w-cap) * 556 / 444); height: var(--card-h); aspect-ratio: 444 / 556; pointer-events: auto; cursor: grab; touch-action: none; position: relative; }",
    ".StampDetail-module__6eujwG__card:active { cursor: grabbing; }",
    ".StampDetail-module__6eujwG__card[data-case] { cursor: pointer; }",
    ".StampDetail-module__6eujwG__figure { perspective: 1400px; transform-origin: 50% center; width: 100%; height: 100%; transform: translate(var(--tx,0px), var(--ty,0px)) rotate(var(--rotZ,0deg)) scale(var(--sx,1), var(--sy,1)); position: relative; }",
    ".StampDetail-module__6eujwG__figure.StampDetail-module__6eujwG__isHeld, .StampDetail-module__6eujwG__figure.StampDetail-module__6eujwG__isFlying { will-change: transform; backface-visibility: hidden; }",
    ".StampDetail-module__6eujwG__morphs { opacity: var(--morph,1); pointer-events: none; position: absolute; inset: 0px; }",
    ".StampDetail-module__6eujwG__figure[data-handoff] .StampDetail-module__6eujwG__morphs { transition: opacity var(--relight-ms,var(--duration-fast)) var(--relight-ease,var(--ease-standard)); }",
    ".StampDetail-module__6eujwG__caseLink { top: calc(100% + (100dvh - var(--card-h)) / 4); color: var(--surface-page); font-family: var(--font-mono); font-size: var(--font-size-label-small); text-transform: uppercase; letter-spacing: 0.04em; white-space: nowrap; visibility: hidden; opacity: 0.7; pointer-events: none; transition: opacity var(--duration-base,.4s) var(--ease-standard); text-decoration: none; position: absolute; left: 50%; translate: -50% -50%; }",
    ".StampDetail-module__6eujwG__caseLink[data-landed] { visibility: visible; pointer-events: auto; }",
    ".StampDetail-module__6eujwG__caseLink[data-landed]:hover, .StampDetail-module__6eujwG__caseLink[data-landed]:focus-visible { opacity: 1; }",
    ".StampDetail-module__6eujwG__caseSoon { margin: 0px; }",
    ".StampDetail-module__6eujwG__caseSoon, .StampDetail-module__6eujwG__caseSoon[data-landed] { opacity: 0.45; pointer-events: none; }",
    ".StampDetail-module__6eujwG__root[data-morph-lift] { z-index: calc(var(--z-morph) + 1); }",
    ".StampDetail-module__6eujwG__root[data-morph-lift] .StampDetail-module__6eujwG__room { pointer-events: none; opacity: 0 !important; transition: none !important; }"
  ],
